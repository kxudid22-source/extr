{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "botNumbers": {
      ".read": true,
      ".write": true
    },
    "codeRequests": {
      ".read": true,
      ".write": true
    },
    "purchases": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": true
      }
    },
    "publicUsers": {
      ".read": true,
      ".write": true
    }
  }
}
